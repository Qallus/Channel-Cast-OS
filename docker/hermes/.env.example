# Local Hermes. Copy to .env in this folder; it is gitignored alongside the app .env.

# The model provider Hermes thinks with. One of these is required.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# The key the Channel Cast app sends as "Authorization: Bearer ...".
# Generate a fresh one, do not reuse the production value:
#   openssl rand -hex 32
API_SERVER_KEY=

# Optional: protect the local dashboard on :9119
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
