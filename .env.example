# Channel Cast environment variables
# Supabase — required (data + audio storage). Get these from Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key (SECRET — server only, bypasses RLS). Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# AI voice (TTS) providers — enable any/all in the Media Studio's voice engine picker
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# ── AI providers (additional) ──────────────────────────────────────
# Claude / Anthropic — key format: sk-ant-api03-...
ANTHROPIC_API_KEY=
# OpenRouter (one key, many models) — key format: sk-or-v1-...
OPENROUTER_API_KEY=
# Optional default OpenRouter model, e.g. anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=
# Hermes agent — usually served via OpenRouter/Together; key + optional base URL
HERMES_API_KEY=
HERMES_API_URL=
# Paperclip AI (optional)
PAPERCLIP_API_KEY=

# ── Email (transactional + inbox) ──────────────────────────────────
# Resend (API send) — key format: re_...
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
# From / reply-to used across mailers
EMAIL_FROM=
EMAIL_REPLY_TO=
# SMTP (outbound)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# IMAP (read inbox)
IMAP_HOST=
IMAP_PORT=
IMAP_SECURE=
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=
# POP (optional fallback)
POP_HOST=
POP_PORT=
POP_SECURE=
POP_USER=
POP_PASSWORD=

# ── Web Push notifications (VAPID) ─────────────────────────────────
# Generate a keypair with:  npx web-push generate-vapid-keys
# (or Node: crypto.createECDH('prime256v1') → base64url of public/private)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── WordPress (optional — frontend/blog integration) ───────────────
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Public base URL of this app (used in emails, webhooks, push)
PUBLIC_APP_URL=

# Optional: custom map tiles (e.g. Mapbox/MapTiler with your key). Defaults to free CARTO tiles.
# Example: https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=

# Twilio — Communications (voice dialpad, call history, SMS, AI voice).
# Reuse the same values as the CTRL+P project. Required:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional — enables the in-browser dialpad (Voice SDK access tokens):
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Optional — multiple caller IDs / SMS-enabled numbers (comma-separated):
TWILIO_PHONE_NUMBERS=
TWILIO_SMS_NUMBERS=
# Set to "true" to validate inbound Twilio webhook signatures in production:
TWILIO_VALIDATE_WEBHOOK=
