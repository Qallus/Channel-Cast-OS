# Channel Cast environment variables
# Supabase (wired in a later phase — the app runs on mock data without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI voice (TTS) providers — enable any/all in the Media Studio's voice engine picker
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Optional: custom map tiles (e.g. Mapbox/MapTiler with your key). Defaults to free CARTO tiles.
# Example: https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
